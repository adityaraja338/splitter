# Optional: the project config is built into src/firebase.js. Set these only to use a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firestore emulator (npm run emulators) instead of the real database
VITE_USE_EMULATOR=false
